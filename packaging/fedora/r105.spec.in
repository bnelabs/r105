Name:           r105
Version:        @VERSION@
Release:        1%{?dist}
Summary:        Native local-first AI harness for OpenAI-compatible backends
License:        MIT
URL:            https://github.com/bnelabs/r105
Source0:        r105
Source1:        LICENSE
Source2:        README.md
Requires:       glibc >= 2.35

%description
r105 is a Rust terminal AI harness with streaming responses, bounded tools,
MCP integration, native plugins, sessions, and sandbox-aware execution.

%prep

%build

%install
install -D -m 0755 %{SOURCE0} %{buildroot}%{_bindir}/r105
install -D -m 0644 %{SOURCE1} %{buildroot}%{_docdir}/r105/LICENSE
install -D -m 0644 %{SOURCE2} %{buildroot}%{_docdir}/r105/README.md

%files
%{_bindir}/r105
%license %{_docdir}/r105/LICENSE
%doc %{_docdir}/r105/README.md

%changelog
* @RELEASE_DATE@ r105 maintainers <maintainers@r105.dev> - @VERSION@-1
- Release @VERSION@.
