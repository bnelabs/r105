class R105 < Formula
  desc "Native local-first AI harness for OpenAI-compatible backends"
  homepage "https://github.com/bnelabs/r105"
  version "__VERSION__"
  license "MIT"

  on_macos do
    if Hardware::CPU.arm?
      url "https://github.com/bnelabs/r105/releases/download/v__VERSION__/r105-macos-arm64.tar.gz"
      sha256 "__MACOS_ARM64_SHA256__"
    else
      url "https://github.com/bnelabs/r105/releases/download/v__VERSION__/r105-macos-x86_64.tar.gz"
      sha256 "__MACOS_X86_64_SHA256__"
    end
  end

  on_linux do
    if Hardware::CPU.arm?
      url "https://github.com/bnelabs/r105/releases/download/v__VERSION__/r105-linux-aarch64.tar.gz"
      sha256 "__LINUX_AARCH64_SHA256__"
    else
      url "https://github.com/bnelabs/r105/releases/download/v__VERSION__/r105-linux-x86_64.tar.gz"
      sha256 "__LINUX_X86_64_SHA256__"
    end
  end

  def install
    bin.install "r105"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/r105 --version")
  end
end
