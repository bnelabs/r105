{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cargo check",
      "type": "shell",
      "command": "cargo",
      "args": ["check", "--all-targets", "--all-features"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "cargo build",
      "type": "shell",
      "command": "cargo",
      "args": ["build", "--release"],
      "group": "build",
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "cargo test",
      "type": "shell",
      "command": "cargo",
      "args": ["test", "--all-targets"],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "cargo clippy",
      "type": "shell",
      "command": "cargo",
      "args": ["clippy", "--all-targets", "--all-features", "--", "-D", "warnings"],
      "group": "test",
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "cargo fmt",
      "type": "shell",
      "command": "cargo",
      "args": ["fmt", "--all"]
    },
    {
      "label": "cargo fmt check",
      "type": "shell",
      "command": "cargo",
      "args": ["fmt", "--all", "--", "--check"]
    },
    {
      "label": "cargo run chat",
      "type": "shell",
      "command": "cargo",
      "args": ["run", "--", "chat"],
      "group": "build",
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "cargo audit",
      "type": "shell",
      "command": "cargo",
      "args": ["audit"],
      "group": "test"
    },
    {
      "label": "cargo outdated",
      "type": "shell",
      "command": "cargo",
      "args": ["outdated"],
      "group": "test"
    },
    {
      "label": "pre-commit run",
      "type": "shell",
      "command": "pre-commit",
      "args": ["run", "--all-files"],
      "group": "test"
    },
    {
      "label": "check release metadata",
      "type": "shell",
      "command": "./packaging/check_release.sh",
      "group": "test"
    },
    {
      "label": "all checks",
      "dependsOn": [
        "cargo fmt check",
        "cargo check",
        "cargo clippy",
        "cargo test",
        "cargo audit",
        "check release metadata"
      ],
      "group": "test"
    }
  ]
}